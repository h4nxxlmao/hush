{
  "name": "@hush/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, API types and constants for hush.hanx.pro (used by the CLI, frontend and backend).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./entities": "./src/entities.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
