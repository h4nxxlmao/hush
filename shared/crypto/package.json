{
  "name": "@hush/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "libsodium-only client-side encryption for hush.hanx.pro. Pure functions, no I/O, no network.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hush/schemas": "workspace:*",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
