{
  "name": "@xnah/hush",
  "version": "0.2.1",
  "private": false,
  "description": "Zero-knowledge .env sync. Push and pull .env files across machines and teammates, encrypted before anything leaves your machine.",
  "license": "GPL-3.0-only",
  "author": "h4nxxlmao",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "hush": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "environment",
    "sync",
    "zero-knowledge",
    "encryption",
    "cli",
    "libsodium"
  ],
  "homepage": "https://hush.hanx.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h4nxxlmao/hush.git"
  },
  "bugs": {
    "url": "https://github.com/h4nxxlmao/hush/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@napi-rs/keyring": "2.1.1",
    "citty": "0.2.2",
    "dotenv": "18.0.8",
    "open": "11.0.4",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hush/crypto": "workspace:*",
    "@hush/schemas": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
